# 모든 텍스트 파일은 저장소에 LF 로 저장하고 체크아웃할 때도 LF 로 내림
# 윈도우에서 CRLF 로 받으면 값 끝에 \r 이 붙어 조용히 어긋남
* text=auto eol=lf

# config-server 가 읽는 파일이므로 반드시 LF
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.conf  text eol=lf

# CRLF 면 환경변수 값 끝에 \r 이 붙어 접속이 조용히 실패함
.env*   text eol=lf

# 바이너리는 손대지 않음
*.png   binary
*.jpg   binary
